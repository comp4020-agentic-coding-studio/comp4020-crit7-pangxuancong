---
import type { Payment, PaymentEvent } from "../lib/schema";
import { buildTimeline, formatDateTime, toIso } from "../lib/payments/presentation";
import Icon from "./Icon.astro";

interface Props {
  payment: Payment;
  events: PaymentEvent[];
}

const { payment, events } = Astro.props;
const items = buildTimeline(payment, events);
const STATE_LABEL = {
  done: "Completed",
  current: "In progress",
  future: "Not started",
  warning: "Delayed",
  failed: "Failed",
} as const;
---

<ol class="timeline">
  {
    items.map((item) => (
      <li class={`tl-item tl-${item.state}`} data-latest={item.latest ? "" : undefined}>
        <span class="tl-node" aria-hidden="true">
          {item.state === "done" && <Icon name="check" size={14} />}
          {item.state === "warning" && <Icon name="clock" size={14} />}
          {item.state === "failed" && <Icon name="x" size={14} />}
          {item.state === "current" && <span class="tl-dot" />}
        </span>
        <span class="tl-connector" aria-hidden="true" />
        <div class="tl-body">
          <p class="tl-title">
            {item.title}
            <span class="visually-hidden"> — {STATE_LABEL[item.state]}</span>
          </p>
          {item.time && (
            <time class="tl-time" datetime={toIso(item.time)}>
              {formatDateTime(item.time)}
            </time>
          )}
          {item.description && <p class="tl-description">{item.description}</p>}
        </div>
      </li>
    ))
  }
</ol>
