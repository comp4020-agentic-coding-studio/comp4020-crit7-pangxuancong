---
import AppLayout from "../../layouts/AppLayout.astro";
import DemoControls from "../../components/DemoControls.astro";
import Icon from "../../components/Icon.astro";
import { getDemoAccount, getLatestPayment } from "../../lib/payments/service";

const { account } = getDemoAccount();
const payment = getLatestPayment(account.id);
---

<AppLayout title="Prototype controls — ANU Student Finance" current="demo">
  <section class="devsurface" aria-labelledby="demo-title">
    <header class="devsurface-head">
      <span class="devsurface-icon" aria-hidden="true"><Icon name="flask" size={22} /></span>
      <div>
        <h1 id="demo-title">Prototype controls</h1>
        <p>Simulate external banking events for the Crit demonstration. These stand in for the bank/card webhooks a real system would receive.</p>
      </div>
    </header>

    <DemoControls payment={payment} />

    <footer class="devsurface-foot">
      <p>These actions update the real database. Each one redirects to the student's tracker so you can watch it respond.</p>
      {
        payment && (
          <a class="btn btn-ghost-dark" href={`/payments/${payment.id}`}>
            View tracker <Icon name="arrow-right" size={16} />
          </a>
        )
      }
    </footer>
  </section>
</AppLayout>
