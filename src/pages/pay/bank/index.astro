---
import AppLayout from "../../../layouts/AppLayout.astro";
import Amount from "../../../components/Amount.astro";
import CopyButton from "../../../components/CopyButton.astro";
import Icon from "../../../components/Icon.astro";
import { getDemoAccount, startPayment } from "../../../lib/payments/service";

// Landing here starts (or resumes) a bank-transfer payment so the reference
// shown is real and persisted, not a front-end placeholder — see
// startPayment: a payment already in flight is reused rather than duplicated.
const { account } = getDemoAccount();
const payment = startPayment(account.id, "BANK_TRANSFER");

if (payment.status !== "INITIATED") {
  return Astro.redirect(`/payments/${payment.id}`, 303);
}
---

<AppLayout
  title="Pay by bank transfer — ANU Student Finance"
  current="account"
  width="narrow"
  crumbs={[{ label: "Tuition account", href: "/" }, { label: "Pay tuition", href: "/pay/" }, { label: "Bank transfer" }]}
>
  <header class="page-head">
    <h1>Pay by bank transfer</h1>
    <p class="page-sub">Transfer the exact amount below using the payment reference provided.</p>
  </header>

  <section class="panel transfer" aria-label="Transfer details">
    <div class="transfer-grid">
      <div class="transfer-amount">
        <p class="label">Payment amount</p>
        <p class="transfer-figure"><Amount cents={payment.amountCents} currency={payment.currency} /></p>
      </div>
      <dl class="transfer-bank">
        <div>
          <dt>Account name</dt>
          <dd>ANU Tuition Payments (demo)</dd>
        </div>
        <div>
          <dt>BSB</dt>
          <dd class="mono">000-000</dd>
        </div>
        <div>
          <dt>Account number</dt>
          <dd class="mono">12345678</dd>
        </div>
      </dl>
    </div>
    <div class="transfer-ref">
      <div>
        <p class="label">Payment reference</p>
        <p class="transfer-ref-code mono">{payment.referenceCode}</p>
      </div>
      <CopyButton value={payment.referenceCode} />
    </div>
  </section>

  <p class="notice notice-warning">
    <Icon name="warning" size={18} />
    <span><strong>Important.</strong> Include this reference exactly so your transfer can be matched to your account.</span>
  </p>

  <p class="notice notice-plain">
    <Icon name="clock" size={18} />
    <span><strong>Expected processing time.</strong> 1–2 business days after your bank sends the transfer.</span>
  </p>

  <form method="post" action={`/api/payments/${payment.id}/transition`}>
    <input type="hidden" name="action" value="confirm-transfer" />
    <button class="btn btn-primary btn-block" data-loading-label="Recording your transfer…">
      <span class="btn-label">I've made the transfer</span>
    </button>
  </form>
  <p class="center-link"><a class="btn-link" href="/">Back to tuition account</a></p>
</AppLayout>
