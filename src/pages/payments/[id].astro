---
import PaymentTimeline from "../../components/PaymentTimeline.astro";
import "../../styles.css";
import { getEvents, getPayment } from "../../lib/payments/service";
import { STATUS_COPY, formatCents, formatTimestamp } from "../../lib/payments/status";

const id = Number(Astro.params.id);
const payment = Number.isInteger(id) ? getPayment(id) : undefined;

if (!payment) {
  return new Response("Payment not found", { status: 404 });
}

const events = getEvents(payment.id);
const copy = STATUS_COPY[payment.status];
const methodLabel = payment.method === "BANK_TRANSFER" ? "Bank Transfer" : "Card";
const isCompleted = payment.status === "COMPLETED";
const isFailed = payment.status === "FAILED";
const isDelayed = payment.status === "DELAYED";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Payment tracker — ANU Payment Tracker</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Tuition account</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Payment status</h1>
      <p class="amount">{formatCents(payment.amountCents, payment.currency)}</p>
      <p class="method">{methodLabel}</p>
      <p class="reference">Reference: <strong>{payment.referenceCode}</strong></p>

      <section
        class:list={[
          "status-card",
          isCompleted && "status-completed",
          isFailed && "status-failed",
          isDelayed && "status-delayed",
        ]}
        aria-live="polite"
      >
        <h2>{copy.title}</h2>
        <p>{copy.description}</p>
        {!isCompleted && !isFailed && <p class="no-action">No action is required right now.</p>}
      </section>

      <PaymentTimeline method={payment.method} status={payment.status} events={events} />

      {
        !isCompleted && !isFailed && (
          <p class="estimate">
            Estimated processing: usually within 1 business day.
            <br />
            Last updated: {formatTimestamp(payment.updatedAt)}
          </p>
        )
      }

      {
        isCompleted && (
          <p class="balance-note">Outstanding balance: {formatCents(0, payment.currency)}</p>
        )
      }

      {
        isFailed && (
          <a class="cta cta-primary" href="/pay/">
            Try another payment method
          </a>
        )
      }

      <p><a href="/">Back to tuition account</a></p>
    </main>
  </body>
</html>
