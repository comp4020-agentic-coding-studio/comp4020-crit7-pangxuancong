---
// README.md, rendered: what this app is and what good looks like here,
// published with the app. spec/readme.test.ts checks the whole of it is here.
import * as readme from "../../README.md";
import AppLayout from "../layouts/AppLayout.astro";

const title = readme.getHeadings().find((h) => h.depth === 1)?.text ?? "README";

// README images are committed to public/ and linked relatively (public/x.png)
// so they render on GitHub; here they're served from the site root.
// Astro routes them through its /_image endpoint; point straight at the built
// static file instead, so no image processing runs on the server.
const html = (await readme.compiledContent())
  .replace(/(src|href)="public\//g, '$1="/')
  .replace(/src="\/_image\?href=([^&"]+)[^"]*"/g, (_, href) => `src="${decodeURIComponent(href)}"`);
---

<AppLayout title={title} current="about" width="narrow">
  <article class="prose" set:html={html} />
</AppLayout>
