---
import AppLayout from "../layouts/AppLayout.astro";
import Amount from "../components/Amount.astro";
import Icon from "../components/Icon.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { getDemoAccount, listPayments } from "../lib/payments/service";
import {
  METHOD_ICON,
  METHOD_LABEL,
  STATUS_LABEL,
  formatDate,
  isTerminal,
  statusTone,
} from "../lib/payments/presentation";

const { account, studentName } = getDemoAccount();
const recent = listPayments(account.id);
const latest = recent[0];
const isActive = latest && !isTerminal(latest.status);
const isFailed = latest?.status === "FAILED";
const isPaid = account.outstandingBalanceCents === 0;
const lastCompleted = recent.find((p) => p.status === "COMPLETED");
const paidCents = account.originalBalanceCents - account.outstandingBalanceCents;
---

<AppLayout title="Tuition account — ANU Student Finance" current="account">
  <header class="page-head">
    <h1>Tuition account</h1>
    <p class="page-sub">{account.semester} <span aria-hidden="true">·</span> {studentName}</p>
  </header>

  <div class="dash-grid">
    <section
      class:list={["panel", "balance", isPaid && "balance-paid", isActive && "balance-active"]}
      aria-labelledby="balance-title"
    >
      <div class="balance-top">
        <h2 id="balance-title" class="label">Outstanding balance</h2>
        {isPaid && <StatusBadge tone="success" label="Paid" />}
        {isActive && latest && <StatusBadge tone="progress" label="Payment in progress" />}
      </div>

      <p
        class="balance-figure"
        data-balance
        data-cents={account.outstandingBalanceCents}
        data-currency={account.currency}
      >
        <Amount cents={account.outstandingBalanceCents} currency={account.currency} />
      </p>

      {
        isPaid ? (
          <p class="balance-caption balance-caption-success">
            <Icon name="shield" size={16} />
            Your {account.semester} tuition is fully paid.
          </p>
        ) : (
          <p class="balance-caption">Due {formatDate(account.dueDate)}</p>
        )
      }

      {
        isActive && latest && (
          <div class="balance-callout">
            <p>
              We're tracking your {METHOD_LABEL[latest.method].toLowerCase()} of{" "}
              <Amount cents={latest.amountCents} currency={latest.currency} />. Your balance will update once processing
              is complete.
            </p>
            <a class="btn btn-primary" href={`/payments/${latest.id}`}>
              Track payment
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        )
      }

      {
        isPaid && lastCompleted && (
          <div class="last-payment">
            <div>
              <p class="label">Last payment</p>
              <p class="last-payment-amount">
                <Amount cents={lastCompleted.amountCents} currency={lastCompleted.currency} />
              </p>
              <p class="muted">
                {METHOD_LABEL[lastCompleted.method]} · {formatDate(lastCompleted.completedAt ?? lastCompleted.updatedAt)}
              </p>
            </div>
            <a class="btn btn-secondary" href={`/payments/${lastCompleted.id}`}>
              View payment
            </a>
          </div>
        )
      }

      {
        !isPaid && !isActive && (
          <div class="balance-actions">
            {isFailed && (
              <p class="inline-alert">
                <Icon name="warning" size={16} />
                Your last payment couldn't be completed. You can try again with any method.
              </p>
            )}
            <a class="btn btn-primary btn-block" href="/pay/">
              Pay tuition
            </a>
          </div>
        )
      }
    </section>

    <section class="panel summary" aria-labelledby="summary-title">
      <h2 id="summary-title" class="panel-title">Account summary</h2>
      <dl class="summary-list">
        <div>
          <dt>Semester</dt>
          <dd>{account.semester}</dd>
        </div>
        <div>
          <dt>Student</dt>
          <dd>{studentName}</dd>
        </div>
        <div>
          <dt>Tuition fee</dt>
          <dd class="num">
            <Amount cents={account.originalBalanceCents} currency={account.currency} />
          </dd>
        </div>
        <div>
          <dt>Paid</dt>
          <dd class="num"><Amount cents={paidCents} currency={account.currency} /></dd>
        </div>
        <div class="summary-total">
          <dt>Outstanding</dt>
          <dd class="num">
            <Amount cents={account.outstandingBalanceCents} currency={account.currency} />
          </dd>
        </div>
      </dl>
    </section>
  </div>

  <div class="dash-lower">
    <section aria-labelledby="recent-title">
      <h2 id="recent-title" class="section-title">Recent payments</h2>
      {
        recent.length === 0 ? (
          <div class="panel empty">
            <span class="empty-icon" aria-hidden="true">
              <Icon name="receipt" size={20} />
            </span>
            <div>
              <p class="empty-title">No payments yet</p>
              <p class="muted">Once you make a payment, you can track it here.</p>
            </div>
          </div>
        ) : (
          <ul class="panel payment-list">
            {recent.map((p) => (
              <li>
                <a class="payment-row" href={`/payments/${p.id}`}>
                  <span class="payment-row-icon" aria-hidden="true">
                    <Icon name={METHOD_ICON[p.method]} size={18} />
                  </span>
                  <span class="payment-row-main">
                    <span class="payment-row-title">{METHOD_LABEL[p.method]}</span>
                    <span class="payment-row-meta">
                      <span class="mono">{p.referenceCode}</span> · {formatDate(p.createdAt)}
                    </span>
                  </span>
                  <span class="payment-row-end">
                    <Amount cents={p.amountCents} currency={p.currency} class="num" />
                    <StatusBadge tone={statusTone(p.status)} label={STATUS_LABEL[p.status]} />
                  </span>
                  <Icon name="arrow-right" size={16} class="payment-row-chevron" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section aria-labelledby="methods-title">
      <h2 id="methods-title" class="section-title">Ways to pay</h2>
      <ul class="method-mini">
        <li class="panel">
          <Icon name="bank" size={20} />
          <div>
            <p class="method-mini-title">Bank transfer</p>
            <p class="muted">Pay from your bank with a unique reference. Usually 1–2 business days.</p>
          </div>
        </li>
        <li class="panel">
          <Icon name="card" size={20} />
          <div>
            <p class="method-mini-title">Card payment</p>
            <p class="muted">Simulated in this prototype. Usually immediate.</p>
          </div>
        </li>
      </ul>
    </section>
  </div>
</AppLayout>

<script>
  // Acknowledge a balance change since this tab last saw the account: count
  // the figure from its old value to the new one, once.
  const el = document.querySelector<HTMLElement>("[data-balance]");
  if (el) {
    const cents = Number(el.dataset.cents);
    let previous: number | null = null;
    try {
      const stored = sessionStorage.getItem("anu-balance");
      previous = stored === null ? null : Number(stored);
      sessionStorage.setItem("anu-balance", String(cents));
    } catch {}

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const figure = el.querySelector(".amount");
    const textNode = figure?.firstChild;
    if (previous !== null && previous !== cents && textNode && !reduce) {
      const fmt = new Intl.NumberFormat("en-AU", { style: "currency", currency: el.dataset.currency ?? "AUD" });
      const start = performance.now();
      const duration = 900;
      el.classList.add("is-updating");
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        textNode.textContent = fmt.format((previous! + (cents - previous!) * eased) / 100);
        if (t < 1) requestAnimationFrame(tick);
        else el.classList.remove("is-updating");
      };
      requestAnimationFrame(tick);
    }
  }
</script>
