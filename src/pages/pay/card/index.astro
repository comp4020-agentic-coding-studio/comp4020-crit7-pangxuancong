---
import AppLayout from "../../../layouts/AppLayout.astro";
import Amount from "../../../components/Amount.astro";
import Icon from "../../../components/Icon.astro";
import { getDemoAccount, startPayment } from "../../../lib/payments/service";

const { account } = getDemoAccount();
const payment = startPayment(account.id, "CARD");

if (payment.status !== "INITIATED") {
  return Astro.redirect(`/payments/${payment.id}`, 303);
}
---

<AppLayout
  title="Card payment — ANU Student Finance"
  current="account"
  width="narrow"
  crumbs={[{ label: "Tuition account", href: "/" }, { label: "Pay tuition", href: "/pay/" }, { label: "Card payment" }]}
>
  <header class="page-head">
    <h1>Card payment</h1>
    <p class="page-sub">This prototype simulates the card network — no card details are collected.</p>
  </header>

  <section class="panel transfer" aria-label="Card payment summary">
    <div class="transfer-grid">
      <div class="transfer-amount">
        <p class="label">Payment amount</p>
        <p class="transfer-figure"><Amount cents={payment.amountCents} currency={payment.currency} /></p>
      </div>
      <dl class="transfer-bank">
        <div>
          <dt>Payment reference</dt>
          <dd class="mono">{payment.referenceCode}</dd>
        </div>
        <div>
          <dt>Card</dt>
          <dd>Demo card •••• 4242</dd>
        </div>
      </dl>
    </div>
  </section>

  <p class="notice notice-plain">
    <Icon name="lock" size={18} />
    <span>Choose an outcome to simulate what the card network would return.</span>
  </p>

  <div class="card-actions">
    <form method="post" action={`/api/payments/${payment.id}/transition`}>
      <input type="hidden" name="action" value="authorise" />
      <button class="btn btn-primary btn-block" data-loading-label="Authorising…">
        <span class="btn-label">Simulate successful authorisation</span>
      </button>
    </form>
    <form method="post" action={`/api/payments/${payment.id}/transition`}>
      <input type="hidden" name="action" value="decline" />
      <button class="btn btn-secondary btn-block" data-loading-label="Declining…">
        <span class="btn-label">Simulate declined card</span>
      </button>
    </form>
  </div>
  <p class="center-link"><a class="btn-link" href="/pay/">Choose a different method</a></p>
</AppLayout>
