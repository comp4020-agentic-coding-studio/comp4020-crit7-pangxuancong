---
import "../../styles.css";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Choose payment method — ANU Payment Tracker</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Tuition account</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Choose payment method</h1>
      <div class="method-grid">
        <a class="method-card" href="/pay/bank/">
          <h2>Bank Transfer</h2>
          <p>Transfer from your bank using a unique payment reference. Processing may take time.</p>
        </a>
        <a class="method-card" href="/pay/card/">
          <h2>Card Payment</h2>
          <p>Simulated card payment for this prototype — no real card is processed.</p>
        </a>
      </div>
    </main>
  </body>
</html>
